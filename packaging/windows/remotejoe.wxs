<?xml version="1.0" encoding="utf-8"?>
<!--
  remotejoe als MSI (WiX 3.14). Gebaut von scripts/build-msi.ps1; die Dateiliste (Komponentengruppe
  „AppFiles“) erzeugt das Skript aus dem Paketordner.

  - Installation pro Benutzer ohne Administratorrechte nach %LOCALAPPDATA%\Programs\remotejoe.
  - Startmenü-Verknüpfung, Eintrag in „Apps und Features“; die Deinstallation entfernt nur den
    Programmordner. Der Datenordner %USERPROFILE%\remotejoe bleibt unberührt.
  - Der UpgradeCode ist fest und darf sich nie ändern: Jede neue MSI ersetzt die alte (MajorUpgrade).
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi" xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Product Id="*" Name="remotejoe" Language="1031" Codepage="1252" Version="$(var.Version)" Manufacturer="John Lose (joeMJ)"
           UpgradeCode="DB4709D5-54F6-4A98-AB02-E96A60D16CE1">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" InstallPrivileges="limited" Platform="x64"
             Languages="1031" SummaryCodepage="1252" Description="remotejoe $(var.Version)"
             Comments="Verbindungsmanager für SSH, RDP, VNC, Web und PowerShell" />

    <!-- Gleiche Version erneut installieren ersetzt sie ebenfalls (neu gebaute MSI). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="Eine neuere Version von remotejoe ist bereits installiert." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="RemotejoeIcon" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="RemotejoeIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/joeMJ/remotejoe" />
    <Property Id="ARPHELPLINK" Value="https://github.com/joeMJ/remotejoe" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLDIR]" After="CostFinalize" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsDir" Name="Programs">
          <Directory Id="INSTALLDIR" Name="remotejoe" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder" />
    </Directory>

    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="6C1E2B8A-3F57-4C1D-9E2A-7B0D5F4A1C93">
        <!-- Symbol aus remotejoe.exe (fester Ort), nicht aus dem Symbol-Zwischenspeicher der MSI: der gehört zur
             Produktkennung, die jedes Update wechselt; angeheftete Taskleisten-Einträge zeigten danach ein leeres Symbol. -->
        <Shortcut Id="AppShortcut" Name="remotejoe" Description="Verbindungsmanager für SSH, RDP, VNC, Web und PowerShell"
                  Target="[INSTALLDIR]remotejoe.exe" WorkingDirectory="INSTALLDIR" />
        <!-- Ordner „Programs“ nur entfernen, wenn er danach leer ist (Windows Installer prüft das). -->
        <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\remotejoe\Installer" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Laufende Programme vor dem Ersetzen der Dateien (vor InstallValidate): remotejoe wird gebeten, sich zu
         schließen; läuft es danach noch, fragt eine Meldung, ob es beendet werden soll (Wiederholen/Abbrechen).
         Worker ohne Fenster gehören zu remotejoe und werden beendet. Sonst wartet Windows Installer auf die
         Dateien (Hängen bei „Erforderliche Informationen werden ermittelt“). -->
    <util:CloseApplication Id="CloseRemotejoe" Target="remotejoe.exe" Sequence="1" CloseMessage="yes" PromptToContinue="yes" RebootPrompt="no"
                           Description="remotejoe läuft noch und muss für die Installation beendet werden. Bitte remotejoe schließen (offene Sitzungen werden getrennt) und dann „Wiederholen“ wählen." />
    <util:CloseApplication Id="CloseWorkerSsh" Target="rj-worker-ssh.exe" Sequence="2" TerminateProcess="0" RebootPrompt="no" />
    <util:CloseApplication Id="CloseWorkerRdp" Target="rj-worker-rdp.exe" Sequence="3" TerminateProcess="0" RebootPrompt="no" />
    <util:CloseApplication Id="CloseWorkerVnc" Target="rj-worker-vnc.exe" Sequence="4" TerminateProcess="0" RebootPrompt="no" />
    <util:CloseApplication Id="CloseWorkerWeb" Target="rj-worker-web.exe" Sequence="5" TerminateProcess="0" RebootPrompt="no" />
    <util:CloseApplication Id="CloseWorkerPsrp" Target="rj-worker-psrp.exe" Sequence="6" TerminateProcess="0" RebootPrompt="no" />
    <util:CloseApplication Id="CloseMcp" Target="rj-mcp.exe" Sequence="7" TerminateProcess="0" RebootPrompt="no" />

    <Feature Id="Main" Title="remotejoe" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Product>
</Wix>
